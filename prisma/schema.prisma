// VERDIXA — Prisma Schema
// DATA-MODEL.md is the authoritative field-level documentation.
// Chief Architect owns this file. No slice agent may add/remove/rename fields
// without an ADR entry in docs/. ADR-001 = Phase 1 baseline. ADR-002 = Phase 2.
// ADR-003 = Phase 3: Rubric, ScoreCard, JudgeAssignment, JudgeConflict, AlgorithmRun.
//            Also removed @@unique([teamId, eventId]) from Project to allow the
//            deliberate duplicate "Dry Harbour" submission from tm_07 per fixtures.json.

generator client {
  provider      = "prisma-client-js"
  // Vendor query engine binaries so Docker images never need a network call at runtime.
  // See blueprint §16.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  participant
  judge
  organizer
  admin
}

enum EventStatus {
  draft
  open
  judging
  closed
}

/// ADR-002: Phase 2 addition
enum ProjectStatus {
  draft
  submitted
  disqualified
}

/// ADR-004: Phase 5 — community voting and comments
enum CommentStatus {
  visible
  hidden // organizer soft-delete; record kept in DB for audit
}

// ─── Identity ─────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  /// Server-owned: never set by the client directly.
  role         Role     @default(participant)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions         Session[]
  teamMemberships  TeamMember[]
  invitesSent      TeamInvite[]      @relation("InviteSentBy")
  organizedEvents  Event[]           @relation("OrganizerEvents")
  auditLogs        AuditLog[]
  /// ADR-003: Judge relations
  judgeAssignments JudgeAssignment[] @relation("JudgeAssignments")
  scorecards       ScoreCard[]       @relation("JudgeScorecards")
  judgeConflicts   JudgeConflict[]   @relation("JudgeConflicts")
  /// ADR-004: Voting & comments
  votes            Vote[]            @relation("UserVotes")
  comments         Comment[]         @relation("UserComments")
  votingWindows    VotingWindow[]    @relation("VotingWindowCreator")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  /// Opaque token stored in signed HttpOnly cookie. Server verifies HMAC on each request.
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ─── Events ───────────────────────────────────────────────────────────────────

model Event {
  id          String      @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  /// ADR-002: Server-side submission cutoff. The server reads this — client timestamps are
  /// NEVER trusted. Null means no deadline (organizer closes manually via status transition).
  submissionDeadline DateTime?
  status      EventStatus @default(draft)
  organizerId String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organizer     User            @relation("OrganizerEvents", fields: [organizerId], references: [id])
  tracks        Track[]
  teams         Team[]
  projects      Project[]
  /// ADR-003
  rubrics            Rubric[]
  algorithmRuns      AlgorithmRun[]
  normalizationRuns  NormalizationRun[]
  /// ADR-004
  votingWindows      VotingWindow[]
}

model Track {
  id      String @id @default(cuid())
  name    String
  eventId String

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  projects Project[]
}

// ─── Teams ────────────────────────────────────────────────────────────────────

model Team {
  id        String   @id @default(cuid())
  name      String
  eventId   String
  createdAt DateTime @default(now())

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members   TeamMember[]
  invites   TeamInvite[]
  projects  Project[]
  /// ADR-003
  conflicts JudgeConflict[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamInvite {
  id        String    @id @default(cuid())
  teamId    String
  /// Random URL-safe token; single-use.
  token     String    @unique
  createdBy String
  /// Null until the invite is accepted.
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator User @relation("InviteSentBy", fields: [createdBy], references: [id])

  @@index([token])
}

// ─── Submissions (ADR-002: Phase 2) ──────────────────────────────────────────

/// A team's hackathon submission.
/// ADR-003: Removed @@unique([teamId, eventId]) to allow the deliberate duplicate
/// "Dry Harbour" submission from tm_07 per fixtures.json. The duplicateOf field
/// tracks collision: when two projects from the same team share a repo_url, the
/// second is seeded with duplicateOf pointing to the first. Both appear in gallery;
/// neither is silently merged or dropped. Organizer sees a DUPLICATE_SUBMISSION
/// audit event at seed time.
model Project {
  id          String        @id @default(cuid())
  title       String
  description String?
  repoUrl     String?
  demoUrl     String?
  videoUrl    String?
  status      ProjectStatus @default(draft)
  /// Set when status transitions to submitted.
  submittedAt DateTime?
  /// Set when submission is locked.
  lockedAt    DateTime?
  /// ADR-003: set when this project shares a repo_url with another from the same team.
  duplicateOf String?

  teamId    String
  eventId   String
  trackId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team        Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  track       Track?            @relation(fields: [trackId], references: [id])
  mediaAssets MediaAsset[]
  /// ADR-003
  assignments JudgeAssignment[]
  scorecards  ScoreCard[]
  /// ADR-004
  votes       Vote[]
  comments    Comment[]

  /// ADR-003: Changed from @@unique to @@index to allow fixture duplicate.
  @@index([teamId, eventId])
  @@index([eventId, status])
  @@index([teamId])
}

/// Screenshot assets for a project. Validated extension + MIME sniff + size cap.
/// Stored under randomized filenames — never the original name. See blueprint §7.
model MediaAsset {
  id           String   @id @default(cuid())
  projectId    String
  /// Randomized UUID-based filename (e.g., "a1b2c3d4.webp"). Never the original.
  filename     String   @unique
  /// Original filename stored for display only, never used for serving.
  originalName String
  mimeType     String
  sizeBytes    Int
  /// Relative path under the uploads volume root (e.g., "uploads/a1b2c3d4.webp")
  storagePath  String
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ─── Judging Engine (ADR-003: Phase 3) ────────────────────────────────────────

/// Rubric defines the weighted criteria used to score projects in an event.
/// Versioned: if criteria change after judging starts, a new version is created.
/// Old ScoreCards keep a reference to the rubric version they were scored against.
model Rubric {
  id        String   @id @default(cuid())
  eventId   String
  version   Int      @default(1)
  /// Only one rubric per event is active at a time.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  event      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  criteria   RubricCriterion[]
  scorecards ScoreCard[]

  @@index([eventId])
}

/// A single scoring criterion within a Rubric.
/// Weights must be positive and sum > 0 (enforced at the service layer).
model RubricCriterion {
  id       String @id @default(cuid())
  rubricId String
  name     String  // e.g., "functionality", "quality", "innovation" — organizer-configurable
  weight   Float   // Must be > 0; enforced by rubricService before saving
  maxScore Int     // e.g., 5; score must be in [1, maxScore]
  rubric Rubric @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  scores CriterionScore[]

  @@index([rubricId])
}

/// Records a single judge's assignment to review a project.
/// Created atomically per AlgorithmRun. Assignments are immutable after creation.
model JudgeAssignment {
  id           String   @id @default(cuid())
  judgeId      String
  projectId    String
  eventId      String
  algorithmRun String   // ID of the AlgorithmRun that produced this
  assignedAt   DateTime @default(now())

  judge     User       @relation("JudgeAssignments", fields: [judgeId], references: [id])
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scorecard ScoreCard?

  @@unique([judgeId, projectId])
  @@index([eventId])
  @@index([judgeId])
}

/// Records a single run of the assignment algorithm.
/// Includes version and optional seed for reproducibility and audit.
model AlgorithmRun {
  id        String   @id @default(cuid())
  eventId   String
  rubricId  String
  version   String   @default("1.0")
  seed      String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])
}

/// A judge's submitted scores for a specific project assignment.
/// References the exact rubric version in effect at time of submission.
model ScoreCard {
  id           String    @id @default(cuid())
  judgeId      String
  projectId    String
  assignmentId String    @unique
  rubricId     String
  submittedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  judge      User            @relation("JudgeScorecards", fields: [judgeId], references: [id])
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignment JudgeAssignment @relation(fields: [assignmentId], references: [id])
  rubric     Rubric          @relation(fields: [rubricId], references: [id])
  scores     CriterionScore[]

  @@unique([judgeId, projectId])
  @@index([judgeId])
}

/// Individual criterion score within a ScoreCard.
model CriterionScore {
  id          String @id @default(cuid())
  scorecardId String
  criterionId String
  score       Int    // Must be in [1, criterion.maxScore]

  scorecard ScoreCard       @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  criterion RubricCriterion @relation(fields: [criterionId], references: [id])

  @@unique([scorecardId, criterionId])
}

/// Stores a persisted normalization run result (inputs + outputs) for audit.
/// Never recomputed silently — organizer triggers explicitly.
model NormalizationRun {
  id          String   @id @default(cuid())
  eventId     String
  rubricId    String
  /// JSON: the judgeScoreMap inputs used
  inputsJson  Json
  /// JSON: the NormalizationResult output (normalizedScores + flags)
  outputJson  Json
  /// k constant used (SHRINKAGE_K)
  shrinkageK  Int      @default(3)
  createdAt   DateTime @default(now())
  createdBy   String   // organizer userId

  event Event @relation(fields: [eventId], references: [id])

  @@index([eventId])
}

/// Declared conflict of interest: this judge must not be assigned to this team's projects.
model JudgeConflict {
  id        String   @id @default(cuid())
  judgeId   String
  teamId    String
  eventId   String
  createdAt DateTime @default(now())

  judge User @relation("JudgeConflicts", fields: [judgeId], references: [id])
  team  Team @relation(fields: [teamId], references: [id])

  @@unique([judgeId, teamId])
  @@index([eventId])
}

// ─── Audit ────────────────────────────────────────────────────────────────────

/// Non-trivial mutations write a record here in the same transaction.
/// See blueprint §10 and §17.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  /// JSON snapshot of relevant changed fields (before/after where meaningful).
  payload    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
}

// ─── Community Voting (ADR-004: Phase 5) ─────────────────────────────────────

/// Configures the open/close window for community voting on an event.
/// Organizer creates/closes this to gate votes. Only one active window per event.
model VotingWindow {
  id          String    @id @default(cuid())
  eventId     String
  opensAt     DateTime
  closesAt    DateTime
  /// Results are hidden from non-organizers while window is open.
  resultsHidden Boolean @default(true)
  createdBy   String
  createdAt   DateTime  @default(now())

  event   Event  @relation(fields: [eventId], references: [id])
  creator User   @relation("VotingWindowCreator", fields: [createdBy], references: [id])
  votes   Vote[]

  @@index([eventId])
}

/// One authenticated vote per user per project per voting window.
/// Soft-immutable — can be retracted by the voter within the window (logged).
/// Design choice: AUTHENTICATED voting (not link-based or email-gated) because
/// participants are already registered accounts; reusing the session cookie avoids
/// a second email-verification flow and its deliverability risk, while still
/// providing an account-level deduplication anchor. IP heuristics supplement
/// account uniqueness for unauthenticated abuse paths.
/// (See JUDGING.md §Voting Mechanism for the full decision rationale.)
model Vote {
  id             String   @id @default(cuid())
  votingWindowId String
  voterId        String
  projectId      String
  /// Snapshot of voter IP at submission time (hashed with SHA-256 for privacy).
  ipHash         String
  /// Randomised ballot seed used to order projects for this voter (reproducible per voter).
  ballotSeed     String
  createdAt      DateTime @default(now())
  /// If retracted, the vote is soft-deleted (audit trail preserved).
  retractedAt    DateTime?

  window  VotingWindow @relation(fields: [votingWindowId], references: [id])
  voter   User         @relation("UserVotes", fields: [voterId], references: [id])
  project Project      @relation(fields: [projectId], references: [id])

  @@unique([votingWindowId, voterId, projectId])
  @@index([votingWindowId])
  @@index([voterId])
  @@index([projectId])
}

/// Rate-limit bucket for unauthenticated or high-frequency vote attempts.
/// One row per (ip_hash, voting_window_id). Checked before any write.
/// Falls back to in-process Map when Redis unavailable.
model VoteRateLimit {
  id             String   @id @default(cuid())
  votingWindowId String
  ipHash         String
  attempts       Int      @default(1)
  windowStart    DateTime @default(now())
  lastAttemptAt  DateTime @default(now())

  @@unique([votingWindowId, ipHash])
  @@index([votingWindowId])
}

/// Project comment — authenticated users only.
model Comment {
  id        String        @id @default(cuid())
  projectId String
  authorId  String
  body      String        @db.Text
  status    CommentStatus @default(visible)
  /// If hidden, reason logged here by organizer.
  hideReason String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation("UserComments", fields: [authorId], references: [id])

  @@index([projectId])
  @@index([authorId])
}
