# VERDIXA Environment Variables
# Copy this file to .env.local for local development
# NEVER commit .env.local to version control

# Database (overridden by docker-compose for container use)
DATABASE_URL="postgresql://verdixa:verdixa_dev_password@localhost:5432/verdixa"

# Session secret — MUST be changed before any real deployment
# Generate: openssl rand -hex 32
SESSION_SECRET="dev_only_not_for_production_change_this"

# Seed credentials (optional overrides)
# SEED_ADMIN_EMAIL="admin@verdixa.dev"
# SEED_ADMIN_PASSWORD="verdixa2026"
